    {
      "name": "8. Registrar primera asistencia",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/asistencias/123"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Resultado esperado\", () => { const r = pm.response.json(); pm.expect(r.estudiante.cedula).to.eql(\"123\"); pm.expect(r.asistencia.estado).to.eql(\"P\"); pm.expect(r.asistencia.fechaClase).to.match(/^\\d{4}-\\d{2}-\\d{2}$/); pm.expect(r.asistencia.fechaHoraRegistro).to.include(\"T\"); });"
            ]
          }
        }
      ]
    },
