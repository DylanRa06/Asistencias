        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/estudiantes"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Resultado esperado\", () => { const lista = pm.response.json().filter(e => e.cedula === \"123\"); pm.expect(lista.length).to.eql(1); pm.expect(lista[0].nombre).to.eql(\"Dylan\"); });"
            ]
          }
        }
      ]
    },
