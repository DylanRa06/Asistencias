{
  "info": {
    "name": "Asistencias - Taller Spring Boot REST",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Iniciar la aplicacion con la lista vacia y ejecutar las peticiones en orden. Crear, actualizar y eliminar retornan HTTP 200 sin cuerpo porque los metodos del taller son void. Registrar asistencia no necesita Body. Los registros se guardan en memoria."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Crear estudiante",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/estudiantes",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"cedula\": \"123\",\n  \"nombre\": \"Dylan\",\n  \"apellido\": \"Ramon\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Resultado esperado\", () => { pm.expect(pm.response.text().trim()).to.eql(\"\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Consultar estudiante",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/estudiantes/123"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Resultado esperado\", () => { pm.expect(pm.response.json()).to.deep.equal({\"cedula\": \"123\", \"nombre\": \"Dylan\", \"apellido\": \"Ramon\"}); });"
            ]
          }
        }
      ]
    },
